<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Register</title>
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background-color: #dff3e2;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.container {
    width: 320px;
    text-align: center;
}

h1 {
    margin-bottom: 5px;
    color: #2f4f2f;
}

p {
    margin-top: 0;
    color: #5f7a5f;
    font-size: 14px;
}

.input-box {
    width: 100%;
    padding: 14px;
    margin: 12px 0;
    border: none;
    outline: none;
    border-radius: 30px;
    background-color: #9bb59b;
    color: white;
    font-size: 14px;
}

.input-box::placeholder {
    color: #eef5ee;
}

.btn {
    width: 100%;
    padding: 14px;
    border-radius: 30px;
    border: none;
    background-color: #4f7f4f;
    color: white;
    font-size: 16px;
    cursor: pointer;
    margin-top: 10px;
}

.options {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-top: 10px;
    color: #2f4f2f;
}

.divider {
    margin: 30px 0 15px;
    display: flex;
    align-items: center;
    color: #5f7a5f;
    font-size: 12px;
}

.divider::before,
.divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: #5f7a5f;
}

.divider span {
    margin: 0 10px;
}

.social {
    display: flex;
    justify-content: space-around;
    margin-top: 15px;
}

.social div {
    width: 50px;
    height: 50px;
    background-color: white;
    border-radius: 50%;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}
.icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    font-size: 20px;
}

.google i {
    color: #db4437;
}

.facebook i {
    color: #1877f2;
}

.instagram i {
    color: #e4405f;
}

</style>
</head>

<body>
<div class="container">
    <h1>Register</h1>
    <p>Create New Account</p>

    <input type="text" class="input-box" placeholder="Full Name">
    <input type="email" class="input-box" placeholder="username@gmail.com">
    <input type="password" class="input-box" placeholder="Password">
    <input type="date" class="input-box" name="dob" required>

    <select class="input-box" placeholder="sex">
        <option disabled selected>Sex</option>
        <option>Male</option>
        <option>Female</option>
    </select>

    <button class="btn">Create</button>

    <div class="options">
        <label><input type="checkbox"> Remember me</label>
        <span>Forgot Password?</span>
    </div>

    <div class="divider">
        <span>Or continue with</span>
    </div>

    <div class="social">
    <div class="icon google">
        <i class="fa-brands fa-google"></i>
    </div>
    <div class="icon facebook">
        <i class="fa-brands fa-facebook-f"></i>
    </div>
    <div class="icon instagram">
        <i class="fa-brands fa-instagram"></i>
    </div>
</div>

</div>
</body>
</html>
